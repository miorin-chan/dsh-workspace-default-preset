{
  "name": "dsh-workspace-agent-preset",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Stores a default agent preset per workspace and starts that workspace's new sessions with it.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "agent-preset",
    "default"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
